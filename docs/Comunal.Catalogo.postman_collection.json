{
  "info": {
    "name": "Comunal - Catálogo API",
    "description": "Colección de endpoints del microservicio Catálogo. Incluye peticiones exitosas y de errores de validación de dominio. Variable {{baseUrl}} por defecto: http://localhost:5090",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5090" }
  ],
  "item": [
    {
      "name": "Peticiones exitosas",
      "item": [
        {
          "name": "Listar todos los objetos",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/objetos", "host": ["{{baseUrl}}"], "path": ["api", "objetos"] }
          }
        },
        {
          "name": "Obtener objeto por Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/objetos/1", "host": ["{{baseUrl}}"], "path": ["api", "objetos", "1"] }
          }
        },
        {
          "name": "Obtener objetos por categoría",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/objetos/categoria/1", "host": ["{{baseUrl}}"], "path": ["api", "objetos", "categoria", "1"] }
          }
        },
        {
          "name": "Publicar objeto (201)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Escalera de aluminio\",\n  \"descripcion\": \"Escalera de 5 pasos, plegable.\",\n  \"categoriaId\": 1,\n  \"propietarioId\": \"22222222-2222-2222-2222-222222222222\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/objetos", "host": ["{{baseUrl}}"], "path": ["api", "objetos"] }
          }
        },
        {
          "name": "Actualizar objeto (204)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Taladro percutor Bosch Pro\",\n  \"descripcion\": \"Taladro con maletín, set de brocas y cargador extra.\",\n  \"categoriaId\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/objetos/1", "host": ["{{baseUrl}}"], "path": ["api", "objetos", "1"] }
          }
        },
        {
          "name": "Retirar objeto (204)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/objetos/3", "host": ["{{baseUrl}}"], "path": ["api", "objetos", "3"] }
          }
        }
      ]
    },
    {
      "name": "Errores de validación de dominio",
      "item": [
        {
          "name": "Publicar sin nombre (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"\",\n  \"descripcion\": \"Algo\",\n  \"categoriaId\": 1,\n  \"propietarioId\": \"22222222-2222-2222-2222-222222222222\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/objetos", "host": ["{{baseUrl}}"], "path": ["api", "objetos"] }
          }
        },
        {
          "name": "Publicar con nombre muy corto (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"ab\",\n  \"descripcion\": \"Algo\",\n  \"categoriaId\": 1,\n  \"propietarioId\": \"22222222-2222-2222-2222-222222222222\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/objetos", "host": ["{{baseUrl}}"], "path": ["api", "objetos"] }
          }
        },
        {
          "name": "Publicar con categoría inexistente (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Bicicleta\",\n  \"descripcion\": \"Rin 26, buen estado.\",\n  \"categoriaId\": 99,\n  \"propietarioId\": \"22222222-2222-2222-2222-222222222222\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/objetos", "host": ["{{baseUrl}}"], "path": ["api", "objetos"] }
          }
        },
        {
          "name": "Obtener objeto inexistente (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/objetos/999", "host": ["{{baseUrl}}"], "path": ["api", "objetos", "999"] }
          }
        }
      ]
    }
  ]
}
